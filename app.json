{
  "expo": {
    "name": "Design Your Pet",
    "slug": "design-your-pet",
    "scheme": "designyourpet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.goodwookie.designyourpet"
    },
    "android": {
      "package": "com.goodwookie.designyourpet",
      "adaptiveIcon": {
        "backgroundColor": "#EFE3C6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16202A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Design Your Pet uses your photos so you can pick a picture of your pet to turn into artwork.",
          "cameraPermission": "Design Your Pet uses the camera so you can take a picture of your pet to turn into artwork.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://www.goodwookie.com/terms-and-conditions",
      "supportEmail": "info@goodwookie.com"
    }
  }
}
